APP_ENV=production
CORS_ORIGINS=https://ssdk-downloadhub.vercel.app,http://localhost:3000
API_BASE_URL=https://ssdk-downloadhub-api.onrender.com
MAX_FILE_SIZE=500000000
MAX_DURATION=3600
RATE_LIMIT_ANALYZE=20/minute
RATE_LIMIT_DOWNLOAD=10/minute
RATE_LIMIT_TRIM=10/minute
TEMP_DIR=temp/jobs
LOG_LEVEL=INFO
